+# Recency Forcing (arXiv 2609.19729, App. B) temporal recency bias on history chunks:
+#   bias = -beta * dt^gamma(t), dt = min(1, max(0, d - recent) / history), gamma(t) = 0.1 * 2^t, t = 1..4,
+# d = chunk distance of a key frame (0 = current chunk)
+TRB_BETA = 4.0
+TRB_GAMMA0 = 0.1
+TRB_RECENT_CHUNKS = 1
+TRB_HISTORY_CHUNKS = 4
+
+
+def shift_temporal_rope(k, freqs, delta):
+    # shift post-RoPE keys [B, L, N, D] by `delta` frames along the temporal axis
+    b, s, n, d = k.shape
+    c = d // 2
+    t = c - 2 * (c // 3)
+    x = torch.view_as_complex(k.float().reshape(b, s, n, c, 2).contiguous())
+    x[..., :t] = x[..., :t] * freqs[delta, :t]
+    return torch.view_as_real(x).reshape(b, s, n, d).to(k.dtype)
+
+
+def temporal_recency_bias(num_frames, chunk_frames, step, sink_frames, device):
+    # TRB of `num_frames` key frames (oldest first) at step t = step + 1;
+    # sink, recent and current chunks get none
+    d = (num_frames - 1 - torch.arange(num_frames, device=device)) // chunk_frames
+    dt = ((d - TRB_RECENT_CHUNKS).clamp(min=0).float() / TRB_HISTORY_CHUNKS).clamp(max=1.0)
+    bias = -TRB_BETA * dt.pow(TRB_GAMMA0 * 2 ** (step + 1))
+    bias = torch.where(d > TRB_RECENT_CHUNKS, bias, torch.zeros_like(bias))
+    bias[:sink_frames] = 0.0
+    return bias
+
+
+def biased_attention(q, k, v, frame_bias, frame_seqlen):
+    # softmax(q k^T / sqrt(D) + bias) v: one flash-attention call per group of frames
+    # that share a bias, merged by log-sum-exp
+    rounded = frame_bias.round(decimals=6)
+    tokens = torch.arange(frame_seqlen, device=q.device)
+    outs, lses = [], []
+    for value in sorted(set(round(float(b), 6) for b in frame_bias.tolist())):
+        idx = ((rounded == value).nonzero().flatten()[:, None] * frame_seqlen + tokens[None]).flatten()
+        out, lse = torch.ops.aten._scaled_dot_product_flash_attention(
+            q.transpose(1, 2), k.index_select(1, idx).transpose(1, 2), v.index_select(1, idx).transpose(1, 2),
+            0.0, False, False)[:2]
+        outs.append(out.transpose(1, 2).float())
+        lses.append(lse.transpose(1, 2).unsqueeze(-1) + value)
+    lse = torch.stack(lses, 0)
+    w = torch.exp(lse - lse.max(0).values)
+    return ((torch.stack(outs, 0) * w).sum(0) / w.sum(0)).to(q.dtype)
+
