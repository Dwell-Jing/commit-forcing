+# Recent-Context Committing: switches, per-call state (set by pipeline/causal_inference.py) and counters.
+#   window: None = the commit pass reads the whole cache; W = only the newest W frames
+#   trb:    optional Recency Forcing reading (TRB) in the denoising passes
+COMMIT_RULE = dict(window=None, trb=False, commit=False, step=-1, commit_calls=0, rule_reads=0, trb_calls=0, read_frame_counts={})
+TRB = dict(beta=4.0, gamma_base=0.1, l_recent=1, l_history=4, chunk=3)
+_TRB_COLUMNS = {}
+
+
+def _trb_bias(abs_list, sink, cur_abs, cur_frames, step):
+    """TRB bias per cache slot at denoising step `step` (0..3); returns (bias, number of history chunks)."""
+    c, lr = TRB["chunk"], TRB["l_recent"]
+    assert cur_frames == c and cur_abs % c == 0 and 0 <= step <= 3, (cur_abs, cur_frames, step)
+    g = TRB["gamma_base"] * 2.0 ** (step + 1)
+    q_last = cur_abs + cur_frames - 1
+    bias, hist = [], set()
+    for j, a in enumerate(abs_list):
+        d = (q_last - a) // c
+        if j >= sink and d > lr:
+            bias.append(-TRB["beta"] * min((d - lr) / TRB["l_history"], 1.0) ** g)
+            hist.add(d)
+        else:
+            bias.append(0.0)
+    return bias, len(hist)
+
+
+def _trb_attention(q, k, v, bias, fs):
+    """softmax(q k^T / sqrt(D) + b) v in one flash-attention call; two extra head channels carry the bias."""
+    assert FLASH_ATTN_2_AVAILABLE or FLASH_ATTN_3_AVAILABLE, "TRB needs flash-attn (the SDPA fallback has no softmax_scale)"
+    B, Lq, H, D = q.shape
+    Lk, P = k.shape[1], 8
+    assert Lk == len(bias) * fs and v.shape[1] == Lk, (Lk, len(bias), fs, tuple(v.shape))
+    key = (tuple(bias), fs, D, k.dtype, str(k.device))
+    col = _TRB_COLUMNS.get(key)
+    if col is None:
+        b = torch.tensor(bias, dtype=torch.float64).repeat_interleave(fs) * math.sqrt(D)
+        hi = b.to(k.dtype)
+        col = torch.stack([hi, (b - hi.double()).to(k.dtype)], -1).view(1, Lk, 1, 2).to(k.device)
+        _TRB_COLUMNS[key] = col
+    qa = torch.cat([q, q.new_ones(B, Lq, H, 2), q.new_zeros(B, Lq, H, P - 2)], -1)
+    ka = torch.cat([k, col.expand(B, Lk, H, 2), k.new_zeros(B, Lk, H, P - 2)], -1)
+    va = torch.cat([v, v.new_zeros(B, Lk, H, P)], -1)
+    return attention(qa, ka, va, softmax_scale=1.0 / math.sqrt(D))[..., :D]


