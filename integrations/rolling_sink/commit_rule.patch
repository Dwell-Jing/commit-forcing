+    def _attend_real_history(self, kv_cache, roped_query, roped_key, v, current_end, frame_seqlen):
+        """Write the clean block into kv_cache["real_k"] / ["real_v"] and attend to them (no replayed frames)."""
+        real_k, real_v = kv_cache["real_k"], kv_cache["real_v"]
+        cache_size, num_new_tokens = real_k.shape[1], roped_key.shape[1]
+        global_end_index = kv_cache["real_global_end_index"].item()
+        local_end_index = kv_cache["real_local_end_index"].item()
+        if current_end > global_end_index and num_new_tokens + local_end_index > cache_size:
+            num_evicted_tokens = num_new_tokens + local_end_index - cache_size
+            real_k[:, :local_end_index - num_evicted_tokens] = real_k[:, num_evicted_tokens:local_end_index].clone()
+            real_v[:, :local_end_index - num_evicted_tokens] = real_v[:, num_evicted_tokens:local_end_index].clone()
+            local_end_index = local_end_index + current_end - global_end_index - num_evicted_tokens
+        else:
+            local_end_index = local_end_index + current_end - global_end_index
+        real_k[:, local_end_index - num_new_tokens:local_end_index] = roped_key
+        real_v[:, local_end_index - num_new_tokens:local_end_index] = v
+        kv_cache["real_global_end_index"].fill_(current_end)
+        kv_cache["real_local_end_index"].fill_(local_end_index)
+        self.num_real_commits += 1
+        # Archive capacity and denoising/replay storage stay fixed; narrow only the commit read.
+        read_tokens = kv_cache["commit_frames"] * frame_seqlen
+        start = max(0, local_end_index - read_tokens)
+        n_read = (local_end_index - start) // frame_seqlen
+        reads = self.commit_read_frame_counts
+        reads[n_read] = reads.get(n_read, 0) + 1
+        return attention(roped_query, real_k[:, start:local_end_index], real_v[:, start:local_end_index])

