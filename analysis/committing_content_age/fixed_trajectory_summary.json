      "start_inclusive": 0.5,
      "stop_exclusive": 2.0,
      "step": 0.25
    },
    "within_prompt_aggregation": "Average the two seeds and five probe positions within each prompt.",
    "interval_method": "Reported 95% paired prompt-bootstrap intervals from 4,000 draws; not recomputed in this release.",
    "slope_method": "Fit slopes against log2(target lag) within each prompt before averaging.",
    "distinct_from_SGF9_fixed_clean_propagation_probe": true
  },
  "scale": "Original diagnostic scales; not the ×100 VBench scale",
  "metric_definitions": {
    "Opening similarity": {
      "unit": "dimensionless",
      "definition": "Mean cosine similarity of three generated-frame DINOv2 embeddings to the normalized mean opening embedding of the fixed reference; full-frame similarity, distinct from own-minus-other-seed Consistency."
    },
    "Absolute saturation change": {
      "unit": "dimensionless",
      "definition": "Absolute relative saturation change from the preceding fixed block to the generated probe block."
    },
    "Absolute brightness change": {
      "unit": "dimensionless",
      "definition": "Absolute relative change in mean HSV value from the preceding fixed block to the generated probe block."
    },
    "Latent distance": {
      "unit": "dimensionless",
      "definition": "L2 distance from the complete preceding fixed three-frame latent block to the generated three-frame probe, divided by the norm of the preceding fixed block."
    },
    "Luma boundary ratio": {
      "unit": "dimensionless",
      "definition": "Adjacent-frame luma difference at the generation boundary divided by the mean difference at the two latent-frame boundaries inside the generated block."
    },
    "Within-latent luma motion": {
      "unit": "0–255 luma scale",
      "definition": "Mean of the remaining adjacent-frame luma differences within latent-frame intervals."
    }
  },
