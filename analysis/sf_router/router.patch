diff --git a/wan/modules/kv_router.py b/wan/modules/kv_router.py
new file mode 100644
index 0000000..c25ad9e
--- /dev/null
+++ b/wan/modules/kv_router.py
@@ -0,0 +1,153 @@
+"""KV router: per pass and per layer, how the cached self-attention reads the KV cache.
+
+A route sets, per pass (s0-s3, commit c) and layer, how many of the newest frames are read: `dense` (all of them) or
+`anchors` (the near window plus every stride-th older frame, merged by log-sum-exp with the far mass raised by
+ln(stride)). `content` and `commit_switch` are controls; see analysis/sf_router/README.md.
+"""
+import math
+
+import torch
+
+from wan.modules.attention import attention
+
+FRAME_TOKENS = 1560
+PASSES = ("s0", "s1", "s2", "s3", "c")
+
+
+def parse_windows(spec, n_layers=30):
+    """'12,20-29=160': 12 frames in every layer, 160 in layers 20-29"""
+    parts = str(spec).split(",")
+    w = [int(parts[0])] * n_layers
+    for seg in parts[1:]:
+        rng, val = seg.split("=")
+        lo, hi = (int(x) for x in rng.split("-")) if "-" in rng else (int(rng), int(rng))
+        for i in range(lo, hi + 1):
+            w[i] = int(val)
+    return w
+
+
+def flash_with_lse(q, k, v):
+    """softmax attention of q [B, L, H, D] over k, v [B, S, H, D]: output and fp32 log-sum-exp [B, L, H, 1]"""
+    r = torch.ops.aten._scaled_dot_product_flash_attention(
+        q.transpose(1, 2).to(torch.bfloat16), k.transpose(1, 2).to(torch.bfloat16),
+        v.transpose(1, 2).to(torch.bfloat16), 0.0, False, False)
+    return r[0].transpose(1, 2), r[1].transpose(1, 2).unsqueeze(-1)
+
+
+class KVRouter:
+
+    def __init__(self, windows, near, far="dense", stride=4, far_log_mass_offset=0.0, content=None,
+                 commit_switch=None, commit_far_window=None, frames_per_block=3, n_layers=30):
+        assert far in ("dense", "anchors") and content in (None, "recent", "rand", "mean")
+        assert content is None or far == "anchors"
+        self.windows = {p: parse_windows(windows[p], n_layers) for p in PASSES}
+        self.near, self.far, self.stride = near, far, stride
+        self.far_log_mass_offset = far_log_mass_offset
+        self.content = content
+        self.commit_switch = commit_switch
+        if commit_switch is not None:
+            assert commit_switch[1] in ("before", "from") and commit_far_window
+            self.commit_far = [commit_far_window] * n_layers
+        self.frames_per_block = frames_per_block
+        self.reset()
+
+    def reset(self, noise_seed=0):
+        self.noise_seed = noise_seed  # seeds the "rand" anchor content
+        self.calls = {p: 0 for p in PASSES}
+        self.seen = {p: set() for p in PASSES}
+        self.far_reads = {}
+        self.far_in = self.far_out = 0
+        self.mass = {}
+        self.content_calls = 0
+        self.commit_windows = []
+        self.events = {p: [] for p in PASSES}
+
+    # per generator call
+    def layer_windows(self, kv_pass, block):
+        if kv_pass == "c" and self.commit_switch is not None:
+            switch_block, when = self.commit_switch
+            far = block < switch_block if when == "before" else block >= switch_block
+            return self.commit_far if far else [self.near] * len(self.windows["c"])
+        return self.windows[kv_pass]
+
+    def begin_call(self, kv_pass):
+        self.calls[kv_pass] += 1
+        start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        start.record()
+        self.events[kv_pass].append((start, end))
+
+    def end_call(self, kv_pass):
+        self.events[kv_pass][-1][1].record()
+
+    # per layer
+    def attend(self, q, kv_cache, local_end_index, current_start_frame, kv_pass, layer):
+        block = current_start_frame // self.frames_per_block
+        windows = self.layer_windows(kv_pass, block)
+        if layer == 0:
+            self.seen[kv_pass].add((min(windows), max(windows), sum(windows)))
+            if kv_pass == "c":
+                self.commit_windows.append(max(windows))
+        start = max(0, local_end_index - windows[layer] * FRAME_TOKENS)
+        k, v = kv_cache["k"][:, start:local_end_index], kv_cache["v"][:, start:local_end_index]
+        near_tok, r = self.near * FRAME_TOKENS, self.stride
+        if self.far == "dense" or k.shape[1] <= near_tok + r * FRAME_TOKENS:
+            return attention(q, k, v)
+        # far anchors: newest frame of each group of r, counted back from the near window
+        kf, kn = k[:, :-near_tok], k[:, -near_tok:]
+        vf, vn = v[:, :-near_tok], v[:, -near_tok:]
+        B, T, H, D = kf.shape
+        nf = T // FRAME_TOKENS
+        keep = (nf // r) * r
+
+        def anchors(x):
+            return x.view(B, nf, FRAME_TOKENS, H, D)[:, nf - keep:].view(B, keep // r, r, FRAME_TOKENS, H, D)[:, :, r - 1]
+
+        ks, vs = anchors(kf), anchors(vf)
+        if self.content is not None:
+            ks, vs = self.replace(ks, vs, kn, vn, kv_pass, layer, block)
+        self.far_in += nf * FRAME_TOKENS
+        self.far_out += ks.shape[1] * FRAME_TOKENS
+        self.far_reads[kv_pass] = self.far_reads.get(kv_pass, 0) + 1
+        on, ln_ = flash_with_lse(q, kn, vn)
+        of, lf = flash_with_lse(q, ks.reshape(B, -1, H, D), vs.reshape(B, -1, H, D))
+        lf = lf + math.log(r) + self.far_log_mass_offset  # two fp32 additions, in this order
+        m = torch.maximum(ln_, lf)
+        wn, wf = torch.exp(ln_ - m), torch.exp(lf - m)
+        acc = self.mass.setdefault((kv_pass, layer), [torch.zeros((), device=q.device, dtype=torch.float32), 0])
+        acc[0] += (wf / (wn + wf)).float().mean()
+        acc[1] += 1
+        return ((on.float() * wn + of.float() * wf) / (wn + wf)).to(torch.bfloat16)
+
+    def replace(self, ks, vs, kn, vn, kv_pass, layer, block):
+        """anchor content controls; ks, vs: [B, n_anchors, FRAME_TOKENS, H, D], kn, vn: the near window"""
+        B, na, S, H, D = ks.shape
+        self.content_calls += 1
+        if self.content == "recent":
+            nn_ = kn.shape[1] // S
+            idx = torch.arange(na, device=ks.device) % nn_
+            return (kn.view(B, nn_, S, H, D).index_select(1, idx).contiguous(),
+                    vn.view(B, nn_, S, H, D).index_select(1, idx).contiguous())
+        if self.content == "mean":
+            return (ks.float().mean(1, keepdim=True).to(ks.dtype).expand_as(ks).contiguous(),
+                    vs.float().mean(1, keepdim=True).to(vs.dtype).expand_as(vs).contiguous())
+        g = torch.Generator(device=ks.device)
+        g.manual_seed(int(self.noise_seed) * 4099 + block * 97 + layer * 7 + 2 * PASSES.index(kv_pass))
+
+        def gaussian(x):
+            xf = x.float()
+            mean, std = xf.mean((1, 2), keepdim=True), xf.std((1, 2), keepdim=True)
+            return (mean + std * torch.randn(xf.shape, generator=g, device=x.device)).to(x.dtype)
+        return gaussian(ks), gaussian(vs)
+
+    # per video
+    def summary(self):
+        torch.cuda.synchronize()
+        ms = {p: float(sum(a.elapsed_time(b) for a, b in ev)) for p, ev in self.events.items()}
+        far_mass = {}
+        for (p, layer), (s, n) in sorted(self.mass.items(), key=lambda kv: (kv[0][0], kv[0][1])):
+            far_mass.setdefault(p, {})[str(layer)] = float(s) / n
+        return dict(calls=dict(self.calls), windows={p: sorted(v) for p, v in self.seen.items()},
+                    far_reads=dict(self.far_reads), far_kept=self.far_out / max(1, self.far_in), far_mass=far_mass,
+                    far_mass_calls={p: {str(l): n for (q, l), (_, n) in sorted(self.mass.items()) if q == p}
+                                    for p in far_mass},
+                    content_calls=self.content_calls, commit_windows=list(self.commit_windows), dit_ms=ms)
